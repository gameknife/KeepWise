{
  "name": "appskeepwise-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:regression": "bash scripts/validate_tauri_desktop_rust_regression.sh",
    "test:diff:core": "bash scripts/validate_tauri_core_diff_regression.sh",
    "tauri:dev": "tauri dev",
    "tauri:dev:mobile-preview": "VITE_FORCE_MOBILE=1 tauri dev --config src-tauri/tauri.mobile-preview.conf.json",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "tauri:build:mac": "tauri build --bundles app,dmg",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:dev:ipad": "bash scripts/run_keepwise_ios_device_dev.sh",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:run": "tauri android run",
    "tauri:android:signing:setup": "bash scripts/setup_keepwise_android_release_signing.sh",
    "tauri:android:run:release": "bash scripts/setup_keepwise_android_release_signing.sh && tauri android run --release",
    "tauri:android:build:internal": "bash scripts/setup_keepwise_android_release_signing.sh && tauri android build --target aarch64 --apk --aab",
    "desktop:release:check": "bash scripts/validate_tauri_desktop_release_check.sh",
    "desktop:release:prepare": "bash scripts/prepare_keepwise_desktop_release.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "d3-sankey": "^0.12.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/d3-sankey": "^0.12.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
